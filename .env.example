# Shared local-development configuration. Do not commit real credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend Application Control Plane
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://localhost/postgres
WORKER_DATABASE_URL=postgresql+psycopg://localhost/postgres

# Supabase Auth & RLS Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq LLM Provider Integration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HubSpot CRM Integration (OAuth v3 & CRM API)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Resend Email Delivery Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=
